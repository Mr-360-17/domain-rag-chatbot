# Copy this file to .env and paste ONE key. .env is git-ignored and must never be committed.
# Google Gemini (used first if set). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Groq (used if no Gemini key). Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
